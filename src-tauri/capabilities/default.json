{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the standalone quick-add window",
  "windows": ["main", "quick-add"],
  "permissions": [
    "autostart:default",
    "core:default",
    "core:window:allow-hide",
    "dialog:default",
    "notification:default",
    "opener:default"
  ]
}
